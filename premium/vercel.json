{
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/qa/coaching",
      "destination": "/index.html"
    },
    {
      "source": "/((?!src(?:/|$)|api(?:/|$)|assets(?:/|$)|\\.well-known(?:/|$)|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "framework": null,
  "installCommand": "",
  "git": {
    "deploymentEnabled": {
      "feature/v2-premium-ops-live-3a": false,
      "feature/v2-premium-ops-live-3bc": false,
      "feature/v2-premium-science-jumolf-block4": false,
      "feature/v2-premium-science-jumolf-rights": false,
      "feature/v2-premium-admin-block5": false,
      "feature/v2-premium-data-exports-block6": false,
      "feature/v2-premium-member-gifts": false,
      "feature/v2-premium-home-harmony": false,
      "feature/v2-premium-home-refinement": false,
      "feature/v2-premium-home-photo-swap": false,
      "feature/v2-premium-home-logo-transparent": false,
      "feature/v2-premium-official-brand": false
    }
  }
}
